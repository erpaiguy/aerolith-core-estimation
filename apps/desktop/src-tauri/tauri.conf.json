{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Estimation",
  "version": "0.1.0",
  "identifier": "com.aerolith.core",
  "build": {
    "beforeDevCommand": { "cwd": "..", "script": "npm run dev" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "cwd": "..", "script": "npm run build" },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aerolith Core",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["aero"],
        "name": "Aerolith project",
        "description": "Aerolith Core project",
        "mimeType": "application/x-aerolith-project",
        "role": "Editor"
      }
    ]
  }
}
