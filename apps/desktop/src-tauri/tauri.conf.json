{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bid Craft",
  "version": "1.4.0",
  "identifier": "com.aerolith.core",
  "build": {
    "beforeDevCommand": { "cwd": "..", "script": "npm run dev" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "cwd": "..", "script": "npm run build" },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bid Craft",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:1420 ws://127.0.0.1:1420 https://mmuwdnzbapnbqnqfrwox.supabase.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["aero"],
        "name": "Bid Craft project",
        "description": "Bid Craft project",
        "mimeType": "application/x-aerolith-project",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBEMkEwN0YwOUVCRjEwNDQKUldSRUVMK2U4QWNxRFhlR01SMUZQSlUvS2luTGd6TmZ0RHI4QnNCckRKMHFseElia0RwenRhRHQK",
      "endpoints": [
        "https://github.com/erpaiguy/aerolith-core-releases/releases/download/v1.0.0/estimation-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
