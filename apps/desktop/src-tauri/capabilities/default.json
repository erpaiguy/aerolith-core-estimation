{
  "identifier": "default",
  "description": "Main window can use native open/save dialogs and .aero commands",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "updater:default",
    "process:default"
  ]
}
